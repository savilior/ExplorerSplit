<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target gives access to the WinRT DataTransferManager used for the native share sheet -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Keep the original output folder so existing Run-at-startup / folder-handler registry entries stay valid -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net8.0-windows\</OutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Explorer2.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- app.manifest intentionally declares PerMonitorV2 DPI awareness for Win32/DWM accuracy -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);backups\**</DefaultItemExcludes>
    <AssemblyName>Explorer2</AssemblyName>
    <RootNamespace>Explorer2</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Explorer2</Product>
    <Description>Explorer2 — lightweight Windows 11 side-by-side split view companion for native File Explorer</Description>
  </PropertyGroup>

</Project>
